<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "routekeeper">
<!ENTITY author "davidwheelen">
<!ENTITY version "2026.08.18">
<!ENTITY pluginURL "https://raw.githubusercontent.com/davidwheelen/unraid-routekeeper/main/routekeeper.plg">
<!ENTITY packageName "routekeeper-2026.08.18-noarch-1.txz">
<!ENTITY packageURL "https://raw.githubusercontent.com/davidwheelen/unraid-routekeeper/main/routekeeper-2026.08.18-noarch-1.txz">
<!ENTITY packageSHA256 "0773ca0ada1766773a5a2dbc58c24e9f18ce7b5054f337da04baa2575bd1f3d8">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="Settings/RouteKeeper" pluginURL="&pluginURL;" min="7.2.0" support="https://github.com/davidwheelen/unraid-routekeeper/issues" project="https://github.com/davidwheelen/unraid-routekeeper" icon="routekeeper">
<CHANGES>
<![CDATA[
### 2026.08.18
- Moved RouteKeeper persistent-config initialization and startup restore launch into the plugin installer script that Unraid runs at boot.
- Keeps event hooks as additional restore triggers while ensuring boot-time plugin installation launches restoration directly.

### 2026.08.17
- Added an early driver_loaded restore hook so saved routes can be restored after reboot even when the array remains stopped.

### 2026.08.16
- Fixed RouteKeeper icon wiring for Unraid Settings and Installed Plugins by using the expected FontAwesome-style routekeeper icon name.
- Bound the routekeeper icon class to the packaged original shield/arrows SVG artwork.

### 2026.08.15
- Reduced the main RouteKeeper page to match Unraid's routing-table layout.
- Moved the save checkbox to the right-side action column.
- Removed inline warning/status detail from live route rows; risky selections now warn during Save Selected.
- Removed the saved-route management table from the main testing layout.

### 2026.08.14
- Moved RouteKeeper into the Network Services Settings tile group instead of rendering inline on the Settings overview.
- Added a RouteKeeper Settings tile icon class backed by the packaged RouteKeeper artwork.
- Replaced the invalid installed-plugin SVG icon path with a valid plugin-manager icon fallback and packaged PNG icon assets.

### 2026.08.13
- Simplified the RouteKeeper Settings page to use a route-table style live route list.
- Added checkbox selection and a single Save Selected action for saving live routes.
- Packaged the RouteKeeper SVG icon for the Settings page and installed plugin metadata.

### 2026.08.11
- Initial test-ready RouteKeeper release.
- Explicitly save and manage selected IPv4 and IPv6 routes.
- Restore enabled routes after startup with bounded network-readiness retries.
- Preserve saved definitions when a live route is temporarily removed.
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/&name;/&packageName;">
<URL>&packageURL;</URL>
<SHA256>&packageSHA256;</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e
upgradepkg --install-new /boot/config/plugins/routekeeper/]]>&packageName;<![CDATA[

CONFIG_DIR="/boot/config/plugins/routekeeper"
RUNTIME_DIR="/run/routekeeper"
PLUGIN_ROOT="/usr/local/emhttp/plugins/routekeeper"

mkdir -p "${CONFIG_DIR}" "${RUNTIME_DIR}"
chmod 0750 "${CONFIG_DIR}" "${RUNTIME_DIR}"

if [[ ! -f "${CONFIG_DIR}/routekeeper.cfg" ]]; then
  printf 'AUTO_RESTORE="yes"\nCONFIG_SCHEMA="1"\n' > "${CONFIG_DIR}/routekeeper.cfg"
  chmod 0640 "${CONFIG_DIR}/routekeeper.cfg"
fi

if [[ ! -f "${CONFIG_DIR}/routes.json" ]]; then
  printf '{\n  "schema": 1,\n  "routes": []\n}\n' > "${CONFIG_DIR}/routes.json"
  chmod 0640 "${CONFIG_DIR}/routes.json"
fi

if [[ ! -f "${CONFIG_DIR}/status.json" ]]; then
  printf '{\n  "schema": 1,\n  "routes": {}\n}\n' > "${CONFIG_DIR}/status.json"
  chmod 0640 "${CONFIG_DIR}/status.json"
fi

if [[ -x "${PLUGIN_ROOT}/scripts/restore-startup.php" ]]; then
  nohup "${PLUGIN_ROOT}/scripts/restore-startup.php" --install >/dev/null 2>&1 &
fi

find /boot/config/plugins/routekeeper -maxdepth 1 -type f -name 'routekeeper-*-noarch-1.txz' ! -name ']]>&packageName;<![CDATA[' -delete
echo "RouteKeeper ]]>&version;<![CDATA[ installed. Open Settings -> RouteKeeper."
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
if [ -r /run/routekeeper/startup.pid ]; then
  RK_PID="$(cat /run/routekeeper/startup.pid 2>/dev/null)"
  case "$RK_PID" in
    (*[!0-9]*|'') ;;
    (*)
      if tr '\000' ' ' < "/proc/${RK_PID}/cmdline" 2>/dev/null | grep -Fq '/usr/local/emhttp/plugins/routekeeper/scripts/restore-startup.php'; then
        kill "$RK_PID" 2>/dev/null || true
      fi
      ;;
  esac
fi
removepkg routekeeper 2>/dev/null || true
rm -rf /usr/local/emhttp/plugins/routekeeper /run/routekeeper
rm -f /boot/config/plugins/routekeeper/routekeeper-*-noarch-1.txz
echo "RouteKeeper removed. Saved configuration was preserved in /boot/config/plugins/routekeeper/."
]]>
</INLINE>
</FILE>
</PLUGIN>
